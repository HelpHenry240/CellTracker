__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# --- 编辑器/系统 ---
.vscode/
.idea/
.DS_Store

